# Get BOT_TOKEN from Telegram @BotFather. Do not commit actual tokens.
BOT_TOKEN=123456:REPLACE_ME
# Numeric Telegram IDs, comma-separated. Access is closed if missing.
ALLOWED_USER_IDS=123456789
# socks5://user:pass@host:1080 or http://host:3128; empty for direct connection.
PROXY_URL=
DATABASE_PATH=/data/wmm.db
TIMEZONE=Europe/Moscow
# Default Russian neural OCR; set tesseract for fallback debugging.
WMM_OCR_ENGINE=rapidocr
